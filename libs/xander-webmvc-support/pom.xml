<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xander</groupId>
        <artifactId>xander-lab-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>xander-webmvc-support</artifactId>
    <name>xander-webmvc-support</name>
    <description>
        Servlet MVC 支撑（V9 §20）：每个 MVC 服务都需要的请求/响应整形，仅此而已。

        内容：
        - GlobalExceptionHandler          把异常映射成统一的 Result 信封。
        - ResultStatusResponseBodyAdvice  让 HTTP 状态与 Result.code 保持一致。
        - AuthInterceptor                 MVC 认证拦截器。
        - WebConfig                       WebMvcConfigurer：拦截器注册与 CORS。

        仅 MVC 服务使用。WebFlux 服务（Gateway）不得依赖本模块：它带 spring-webmvc 与
        jakarta.servlet。两个运行时 starter 声明为 provided，消费方自备，不会被传递依赖带过去
        （provided 仍在 test classpath 上，本模块自己的测试可用）。

        不属于本模块：PasswordEncoderConfig（BCrypt bean，identity 域配置）、
        ShedLockConfiguration（调度接线），两者都留在应用模块。
    </description>

    <dependencies>
        <!-- Result, Constants. Version managed by the reactor (same ${project.version}). -->
        <dependency>
            <groupId>com.xander</groupId>
            <artifactId>xander-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- UserContext (trusted identity) and JwtUtil (token verifier, incl. the role claim). -->
        <dependency>
            <groupId>com.xander</groupId>
            <artifactId>xander-auth-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            AccessTokenLookupPort               AuthInterceptor 用它判定令牌有效性。
            FeatureModelNotConfiguredException  GlobalExceptionHandler 映射成 HTTP 400。

            这是本仓库唯一依赖业务契约的库：GlobalExceptionHandler 是整类搬过来的。
        -->
        <dependency>
            <groupId>com.xander</groupId>
            <artifactId>core-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            MVC 运行时：@RestControllerAdvice、ResponseBodyAdvice、WebMvcConfigurer、
            HandlerInterceptor、jakarta.servlet。provided（见上）。版本由 Spring Boot BOM 管。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
            GlobalExceptionHandler 把 RedisConnectionFailureException / RedisSystemException
            （spring-data-redis）与 DataAccessException（spring-tx）映射成 HTTP 503。
            这些是 @ExceptionHandler 里的**类字面量**，所以运行期必须在 classpath 上，不只是编译期。

            provided：消费方自备（apps/core-host 已声明）。缺了它会在**注册 advice 时**启动失败，
            不是请求期静默出错。若将来有 MVC 服务不能带 Redis，就得把这一段 handler 拆出去。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 本模块自己的测试（AuthInterceptorTest / GlobalExceptionHandlerTest）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- No spring-boot-maven-plugin: see libs/xander-model/pom.xml for why. -->
        </plugins>
    </build>

</project>
