<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xander</groupId>
        <artifactId>xander-lab-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>xander-lab-backend</artifactId>
    <name>dinqorai-backend</name>
    <description>DinQorAI Backend Project</description>

    <dependencies>
        <!--
            Shared kernel extracted in Wave 0B (V9 §19 / §20).
            Version is ${project.version} because the library is released in lockstep with the
            application; it is resolved from the reactor, so `mvn test` at the repo root builds
            it first and no `mvn install` step is needed.
        -->
        <dependency>
            <groupId>com.xander</groupId>
            <artifactId>xander-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- MyBatis / MyBatis-Plus support: MybatisPlusConfig + PageData (V9 §20). -->
        <dependency>
            <groupId>com.xander</groupId>
            <artifactId>xander-mybatis-support</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            Auth core: UserContext (trusted identity model) + JwtUtil (token verifier), V9 §20.
            This is the lib the WebFlux Gateway will share with us, which is why it must stay
            free of MVC, WebFlux implementation and Redis.
        -->
        <dependency>
            <groupId>com.xander</groupId>
            <artifactId>xander-auth-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            MVC support: GlobalExceptionHandler + ResultStatusResponseBodyAdvice + WebConfig +
            AuthInterceptor (V9 §20). V9 §20 says "仅 MVC 服务使用": the WebFlux Gateway must
            NOT depend on this, which is why spring-boot-starter-web is declared `provided`
            inside it rather than inherited.
        -->
        <dependency>
            <groupId>com.xander</groupId>
            <artifactId>xander-webmvc-support</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            Content-domain service-to-service contract: BlogPublisher / PublishCommand /
            PublishResult / PublishingLimits (V9 §18 / §91). Both the content domain and the
            integration domain reach for these types, so they cannot live in either one.
            Zero transitive dependencies by design; see contracts/content-api/pom.xml.
        -->
        <dependency>
            <groupId>com.xander</groupId>
            <artifactId>content-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            Object-storage service-to-service contract: OssPort / UploadResponse
            (V9 §18 / §91). Four domains across four deployment units injected the concrete
            integration.oss.OssService and read its result type, so the port and its data
            cannot live in the integration domain. Zero transitive dependencies by design;
            see contracts/integration-api/pom.xml.
        -->
        <dependency>
            <groupId>com.xander</groupId>
            <artifactId>integration-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            Core-host service-to-service contract: ModelGateway + ModelEndpoint +
            FeatureModelNotConfiguredException (V9 §18 / §91). The implementation
            (ModelGatewayService, reading model_provider / model_feature_config) stays in the
            admin domain, but the consumers sit in three future deployment units: dinqor-agent,
            dinqor-content-automation and dinqor-core-host. Zero transitive dependencies by
            design; see contracts/core-api/pom.xml.
        -->
        <dependency>
            <groupId>com.xander</groupId>
            <artifactId>core-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            Payment / points service-to-service contract: BillingBiz, the biz_type catalogue
            (V9 §18 / §91). Every charging call site has to name what it charges for, and those
            call sites sit in six domains across three future deployment units. The
            implementation (BillingService over three MyBatis mappers) stays in the billing
            domain and needs a port, not a move; see contracts/payment-api/pom.xml.
        -->
        <dependency>
            <groupId>com.xander</groupId>
            <artifactId>payment-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            Remote-tool-supply service-to-service contract: RemoteToolCatalog / RemoteTool /
            RemoteToolCall (V9 §18 / §91). The integration domain's MCP client implemented the
            agent domain's AgentTool / AgentDynamicToolSource and called AgentToolRegistry,
            which points the wrong way across the dinqor-platform-integration /
            dinqor-agent boundary. Note the package is com.xander.lab.agent.spi, not
            .agent.api, because that domain already owns .agent.api as its frontend HTTP layer.
            Zero transitive dependencies by design; see contracts/agent-api/pom.xml.
        -->
        <dependency>
            <groupId>com.xander</groupId>
            <artifactId>agent-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            Automation service-to-service contract: EmailReminderPort / ContentPlanPort and the
            read models and write drafts they carry (V9 §18 / §91). Six agent tools injected
            automation's concrete @Service classes (EmailReminderService / BlogContentPlanService)
            straight from their application layer, crossing the dinqor-agent /
            dinqor-content-automation boundary. Note the package is
            com.xander.lab.automation.spi, not .automation.api, because that domain already owns
            .automation.api as its frontend HTTP layer (20 controllers / VOs / request bodies).
            Zero transitive dependencies by design; see contracts/automation-api/pom.xml.
        -->
        <dependency>
            <groupId>com.xander</groupId>
            <artifactId>automation-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            recitation's service-to-service contract, for the agent tools and the automation
            services that read the user's knowledge materials. The package is
            com.xander.lab.recitation.spi, not .recitation.api, because that domain already owns
            .recitation.api as its frontend HTTP layer (CreateRecitationMaterialRequest,
            RecitationMaterialView, RecitationAttemptView, UpdateRecitationMaterialRequest,
            KnowledgeQuizAttemptView).
            Zero transitive dependencies by design; see contracts/recitation-api/pom.xml.
        -->
        <dependency>
            <groupId>com.xander</groupId>
            <artifactId>recitation-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            blogagent's service-to-service contract, for the agent tools that generate and
            publish blog posts. The package is com.xander.lab.blogagent.spi, not
            .blogagent.api, because that domain already owns .blogagent.api as its frontend
            HTTP layer (BlogAgentController, BlogAgentTaskCreateRequest, BlogAgentTaskVO,
            BlogAgentSessionVO, BlogAgentMessageRequest).
            Zero transitive dependencies by design; see contracts/blogagent-api/pom.xml.
        -->
        <dependency>
            <groupId>com.xander</groupId>
            <artifactId>blogagent-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.vladsch.flexmark</groupId>
            <artifactId>flexmark-all</artifactId>
            <version>0.64.8</version>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.1</version>
        </dependency>
        <!-- MCP server transport, using Jackson 2 to stay compatible with Spring Boot 3.2. -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-core</artifactId>
            <version>${mcp.sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-json-jackson2</artifactId>
            <version>${mcp.sdk.version}</version>
        </dependency>
        <!--
            MCP SDK 的默认 mapper 是裸 new ObjectMapper()，不带 JSR-310；
            带 LocalDate 的工具返回值会在传输层序列化时抛 InvalidDefinitionException。
            McpJsonMapperFactory 显式注册 JavaTimeModule，所以这里也显式声明依赖
            （此前只靠 spring-boot-starter-json 传递进来，版本仍由 spring-boot-dependencies 管理）。
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 智能体对话 WebSocket 流式推送（小程序不支持 SSE 流式读取） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>4.17.0</version>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.5</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <!-- BCrypt 密码哈希 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 阿里云 OSS -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <version>3.17.4</version>
        </dependency>
        <!--
            ShedLock：多实例定时任务互斥（V9 §67 / §69）。
            后端刻意选 MySQL 而不是 Redis —— 定时任务本身不该依赖 Redis，
            否则 Redis 故障会连带停掉所有后台任务。
            默认关闭（shedlock.enabled），见 config/ShedLockConfiguration：
            Wave 0A 是单实例，靠 DB 原子领取已能保证恰好一次；锁是扩到多实例时才需要的能力。
        -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>5.13.0</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>5.13.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Declared here and not in the parent on purpose: this is the only module that
                produces an executable jar. Putting it in the parent would make every library
                inherit the repackage goal, which needs a main class and would fail their build.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
