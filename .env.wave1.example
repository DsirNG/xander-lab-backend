# Copy this file to .env.wave1 and replace every placeholder before deployment.
# Keep real credentials out of Git. Wave 1 expects Nacos, MySQL and Redis to be
# provided by the test environment rather than by this Compose project.

MIGRATION_DB_URL=jdbc:mysql://<mysql-host>:3306/<migration-database>?useSSL=false&serverTimezone=UTC
MIGRATION_DB_PASSWORD=<migration-database-password>

CORE_DB_URL=jdbc:mysql://<mysql-host>:3306/<core-database>?useSSL=false&serverTimezone=UTC
CORE_DB_PASSWORD=<core-database-password>

NACOS_SERVER_ADDR=<nacos-host>:8848
NACOS_NAMESPACE=<nacos-namespace>

# Optional: inject non-database Redis/mail/OSS/model secrets from a private file.
# This path is relative to infrastructure/docker/docker-compose.wave1.yml.
# BACKEND_ENV_FILE=../../.env.production

# Wave 1 keeps the legacy refresh behavior until clients complete Wave 2 migration.
AUTH_REFRESH_ENABLED=false
