{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dinqor-agent",
  "main": "src/index.ts",
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  // OSS endpoints and model settings are configured per Cloudflare account.
  "keep_vars": true,
  "compatibility_date": "2026-10-10",
  // Keep OSS traffic on the Hong Kong route; LAX-to-Beijing uploads stalled.
  "placement": { "region": "aws:ap-east-1" },
  "secrets": {
    "required": [
      "JWT_SECRET",
      "INTERNAL_SERVICE_TOKEN",
      "CORE_SERVICE_URL",
      "CORE_SERVICE_TOKEN",
      "CONTENT_AUTOMATION_SERVICE_URL",
      "CONTENT_AUTOMATION_SERVICE_TOKEN"
    ]
  },
  "vars": {
    "AGENT_OSS_OBJECT_PREFIX": "agent-attachments",
    "AGENT_MCP_CLIENT_ENABLED": "false",
    "PPT_RENDERER_URL": "https://api-ppt.dsircity.top"
  },
  "services": [
    { "binding": "CORE_SERVICE", "service": "dinqor-core" },
    { "binding": "CONTENT_AUTOMATION_SERVICE", "service": "dinqor-content-automation" }
  ],
  "dev": { "port": 8789 },
  "observability": { "enabled": true },
  "durable_objects": { "bindings": [
    { "name": "IMAGE_TASKS", "class_name": "AgentImageTaskObject" },
    { "name": "PRESENTATION_TASKS", "class_name": "AgentPresentationTaskObject" }
  ] },
  "migrations": [
    { "tag": "image-task-v1", "new_sqlite_classes": ["AgentImageTaskObject"] },
    { "tag": "presentation-task-v1", "new_sqlite_classes": ["AgentPresentationTaskObject"] }
  ],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "dinqor-agent-local",
    "database_id": "82bd76bc-9be1-401c-b52e-8c56ce756902",
    "migrations_dir": "migrations"
  }]
}
