{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dinqor-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "secrets": {
    "required": [
      "JWT_SECRET",
      "CORE_SERVICE_TOKEN",
      "AGENT_SERVICE_TOKEN",
      "PLATFORM_INTEGRATION_SERVICE_TOKEN",
      "CONTENT_AUTOMATION_SERVICE_TOKEN",
      "BLOGHTML_PREVIEW_SERVICE_TOKEN",
      "PAYMENT_SERVICE_TOKEN"
    ]
  },
  "vars": {
    "CORS_ALLOWED_ORIGINS": "https://dinqor.cn",
    "GATEWAY_RATE_LIMIT_ENABLED": "true"
  },
  "services": [
    { "binding": "CORE_SERVICE", "service": "dinqor-core" },
    { "binding": "AGENT_SERVICE", "service": "dinqor-agent" },
    { "binding": "PAYMENT_SERVICE", "service": "dinqor-payment" },
    { "binding": "PLATFORM_INTEGRATION_SERVICE", "service": "dinqor-platform-integration" },
    { "binding": "CONTENT_AUTOMATION_SERVICE", "service": "dinqor-content-automation" },
    { "binding": "BLOGHTML_PREVIEW_SERVICE", "service": "dinqor-bloghtml-preview" }
  ],
  "ratelimits": [
    {
      "name": "GATEWAY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "dev": { "port": 8787 },
  "observability": { "enabled": true }
}
